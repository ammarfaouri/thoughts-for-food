{
  "name": "thoughts-for-food-api",
  "version": "2.0.0",
  "description": "Modernized backend API for the Thoughts for Food recipe-sharing app",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run test/AuthService.test.ts test/RecipeService.test.ts test/api.test.ts",
    "test:db": "vitest run test/db",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:dev": "prisma migrate dev --skip-generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "auth:cleanup-refresh-tokens": "tsx src/scripts/cleanupRefreshTokens.ts",
    "prepare": "node scripts/install-husky.cjs"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs,json,md,yml,yaml}": "prettier --write",
    "*.{ts,js,cjs,mjs}": "eslint --fix"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "author": "Ammar Faouri",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.8.3",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
